{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnotherWorldbuilder",
  "version": "0.1.62",
  "identifier": "com.dicefoxcreations.anotherworldbuilder",
  "build": {
    "frontendDist": "../../../build/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "AnotherWorldbuilder",
        "width": 1200,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "files": {
          "/usr/share/doc/anotherworldbuilder/THIRD-PARTY-NOTICES.txt": "../../../build/public/licenses.txt"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNUI5NUVFRDg2RDA4QzcKUldUSENHM1k3cFZiUWM3ZTBNTEliK0U4RXFkblBPbVB0SHBOZWl6aDc1dGJPbzJGMzJLN1pEUTEK",
      "endpoints": [
        "https://github.com/dicefoxcreations/AnotherWorldbuilder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
